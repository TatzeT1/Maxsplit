rules_version = '2';

// Deny-all placeholder for Phase 0. Receipt uploads (Phase 4) will scope reads
// and writes to authenticated members of the owning group, mirroring the
// Firestore rules in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
