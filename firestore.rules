rules_version = '2';

// Per ADR-001 (docs/DECISIONS.md), all writes go through Next.js Server Actions
// using the Firebase Admin SDK, which bypasses these rules entirely. Rules here
// exist to (a) gate realtime client reads to group members and (b) deny every
// client write as a backstop — nothing should ever reach Firestore via a
// client-issued write. Deny by default; only add narrow, explicit `allow` rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Backstops adminSetUserBanned (lib/actions/admin.ts): the Firebase Auth
    // account is already disabled and its refresh tokens revoked at that
    // point, but a still-live client ID token (issued before the ban, not
    // yet expired) would otherwise keep working against these rules for up
    // to an hour.
    function isBanned() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && !isBanned() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && !isBanned() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /recurring/{ruleId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /activityLog/{logId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /tournaments/{tournamentId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;

        // One online match's move-by-move board — both players and any
        // spectator in the group watch it live; only playOnlineMove writes.
        match /liveMatches/{matchId} {
          allow read: if isGroupMember(groupId);
          allow write: if false;
        }

        // The face-down memory deck. Readable by nobody — a player who could
        // read it could see every card before flipping it.
        match /liveSecrets/{matchId} {
          allow read, write: if false;
        }

        // Who is looking at the game right now (markTournamentPresence) —
        // only the push sender reads it, to skip "Du bist dran" for them.
        match /presence/{uid} {
          allow read, write: if false;
        }

        // When a match's waiting player last nudged the other (nudgeOpponent)
        // — the server's rate limit, nothing a client needs.
        match /nudges/{matchId} {
          allow read, write: if false;
        }
      }

      // An online luck round (ADR-005) — the scratch cards everyone
      // scratches on their own phone. Every member watches it live; only
      // lib/actions/luck-rounds.ts writes. No hidden state lives anywhere:
      // a card's face is drawn by the server the moment it's scratched.
      match /luckRounds/{roundId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // Estimate rounds (ADR-007) — "Schätzfragen", one phone or online. Every
      // member watches a round live; only lib/actions/estimate-rounds.ts writes.
      // The truth and the still-hidden guesses live in secrets/ and reach this
      // (member-readable) document only when a stage is revealed, in the same
      // transaction that closes it.
      match /estimateRounds/{roundId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;

        // The full bank row as played + hidden guesses. Readable by nobody:
        // a member who could read it would see the answer before guessing.
        // Rules do not cascade, so this needs its own block.
        match /secrets/{stageIndex} {
          allow read, write: if false;
        }
      }

      // Which questions this group has seen and the anti-spam creation log
      // (estimateState/seen). Server-only: a member who could read the seen
      // set could learn which questions are coming next.
      match /estimateState/{docId} {
        allow read, write: if false;
      }

      // Doc id == uid, so a member can only ever read their own read
      // receipt — no need to gate on it beyond that plus membership.
      match /chatReads/{uid} {
        allow read: if isSignedIn() && !isBanned() && request.auth.uid == uid &&
          isGroupMember(groupId);
        allow write: if false;
      }
    }

    // Push subscriptions (lib/push/store.ts): a device's push endpoint and
    // encryption keys. Only the server reads or writes them — a client that
    // could read one could learn someone else's devices.
    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    // Deny-all backstop for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
