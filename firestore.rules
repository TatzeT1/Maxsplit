rules_version = '2';

// Per ADR-001 (docs/DECISIONS.md), all writes go through Next.js Server Actions
// using the Firebase Admin SDK, which bypasses these rules entirely. Rules here
// exist to (a) gate realtime client reads to group members and (b) deny every
// client write as a backstop — nothing should ever reach Firestore via a
// client-issued write. Deny by default; only add narrow, explicit `allow` rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Backstops adminSetUserBanned (lib/actions/admin.ts): the Firebase Auth
    // account is already disabled and its refresh tokens revoked at that
    // point, but a still-live client ID token (issued before the ban, not
    // yet expired) would otherwise keep working against these rules for up
    // to an hour.
    function isBanned() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && !isBanned() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && !isBanned() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /recurring/{ruleId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /activityLog/{logId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // Doc id == uid, so a member can only ever read their own read
      // receipt — no need to gate on it beyond that plus membership.
      match /chatReads/{uid} {
        allow read: if isSignedIn() && !isBanned() && request.auth.uid == uid &&
          isGroupMember(groupId);
        allow write: if false;
      }
    }

    // Deny-all backstop for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
