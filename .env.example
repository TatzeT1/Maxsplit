# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Firebase client config (public — safe to expose to the browser).
# Firebase Console -> Project settings -> Your apps -> web app -> firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase emulator suite
# (run with `pnpm emulators`) instead of the real Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Only set these three when NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true — the
# Admin SDK auto-detects these standard var names and routes server-side
# calls to the local emulators instead of production Firebase.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Firebase Admin SDK service account, base64-encoded JSON. Server-only, never
# exposed to the client. Generate: Firebase Console -> Project settings ->
# Service accounts -> Generate new private key, then base64-encode the file.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Receipt scan (📷 Beleg) — optional, server-only, read at runtime (a redeploy
# is enough, no rebuild). Neither key set → the scan button is hidden and
# items can only be typed in. Gemini is tried first, OpenRouter if it fails.
# Gemini: https://aistudio.google.com/apikey (free tier, no card needed)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# OpenRouter: https://openrouter.ai/settings/keys (free models: ids ending in :free)
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openrouter/free
